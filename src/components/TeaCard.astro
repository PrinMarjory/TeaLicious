---
import type { CollectionEntry } from "astro:content";
import { teaTypes } from "../data/teaType.ts";

interface Props {
    tea: CollectionEntry<"teas">;
    }

const { tea } = Astro.props;

const teaTypeLabel =
teaTypes.find((type) => type.id === tea.data.type)?.label ?? tea.data.type;
---

<a
    href={`/teas/${tea.id}`}
    class="tea-card-link"
    data-tea-type={tea.data.type}
>
  <article class="tea-card" data-tea-type={tea.data.type}>
    <div class="tea-card-header">
      <span class="tea-type">{teaTypeLabel}</span>
    </div>

    <div class="tea-card-content">
      <h2>{tea.data.name}</h2>

      <p class="tea-brand">{tea.data.brand}</p>

      {tea.data.shortDescription && (
          <p class="tea-description">{tea.data.shortDescription}</p>
      )}
    </div>

    <span class="tea-card-arrow">→</span>
  </article>
</a>

<style>
  .tea-card-link {
    display: flex;
    color: inherit;
    text-decoration: none;
  }

  .tea-card-link[hidden] {
    display: none;
  }

  .tea-card {
    position: relative;
    width: 100%;
    min-height: 190px;
    padding: 24px;
    box-sizing: border-box;

    display: flex;
    flex-direction: column;

    background: var(--color-surface);
    border: 1px;
    border-radius: var(--radius-medium);

    transition:
        transform 0.2s ease,
        box-shadow 0.2s ease,
        border-color 0.2s ease;
  }

  .tea-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-primary);
    box-shadow: 0 8px 24px rgba(61, 56, 50, 0.08);
  }

  .tea-card-header {
    margin-bottom: 18px;
  }

  .tea-type {
    display: inline-block;
    padding: 6px 10px;

    border-radius: 999px;
    background: var(--color-primary-light);
    color: var(--color-primary);

    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .tea-card-content {
    flex: 1;
  }

  .tea-card h2 {
    margin: 0;
    font-size: 1.4rem;
  }

  .tea-brand {
    margin: 6px 0 16px;
    color: var(--color-text-muted);
    font-size: 0.95rem;
  }

  .tea-description {
    margin: 0;
    color: var(--color-text-muted);
    line-height: 1.5;
    font-size: 0.9rem;
  }

  .tea-card-arrow {
    align-self: flex-end;
    color: var(--color-primary);
    font-size: 1.3rem;
    transition: transform 0.2s ease;
  }

  .tea-card:hover .tea-card-arrow {
    transform: translateX(4px);
  }

  @media (max-width: 700px) {
    .tea-card {
      min-height: 170px;
      padding: 20px;
    }

    .tea-card h2 {
      font-size: 1.3rem;
    }
  }
</style>